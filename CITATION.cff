cff-version: 1.2.0
title: phasecurvefit
message: >-
  If you use this software, please cite it using the metadata below, together
  with the paper behind whichever component you used (see `references`).
type: software
authors:
  - name: GalacticDynamics
  - given-names: Nathaniel
    family-names: Starkman
    orcid: 'https://orcid.org/0000-0003-3954-3291'
repository-code: 'https://github.com/GalacticDynamics/phasecurvefit'
abstract: >-
  Construct paths through phase-space points, supporting many different
  algorithms.
license: MIT
references:
  - type: article
    title: >-
      Charting Galactic Accelerations with Stellar Streams and Machine Learning
    authors:
      - family-names: Nibauer
        given-names: Jacob
    year: 2022
    notes: >-
      Cite if you use momentum-weighted ordering.
    identifiers:
      - type: other
        value: 'arXiv:2201.12042'
  - type: article
    title: 'Data analysis recipes: Fitting a model to data'
    authors:
      - family-names: Hogg
        given-names: David W.
      - family-names: Bovy
        given-names: Jo
      - family-names: Lang
        given-names: Dustin
    year: 2010
    notes: >-
      Cite if you use mixture-model membership / outlier rejection.
    identifiers:
      - type: other
        value: 'arXiv:1008.4686'
